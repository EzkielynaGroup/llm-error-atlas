{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EzkielynaGroup/llm-error-atlas/schema/errors.schema.json",
  "title": "llm-error-atlas data file",
  "description": "One file per provider or layer. Every entry must come from public documentation linked in `docs`.",
  "type": "object",
  "required": ["provider", "name", "source", "entries"],
  "properties": {
    "provider": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "Same as the file name without .json" },
    "name": { "type": "string" },
    "source": { "type": "string", "format": "uri", "pattern": "^https://" },
    "fallback": { "type": "boolean", "description": "true only for generic.json (status-code fallbacks)" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layer", "status", "match", "title", "cause", "retryable", "user_fix", "operator_fix", "docs", "last_verified", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$" },
          "layer": { "enum": ["provider", "gateway", "relay", "local", "http", "network"] },
          "status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "requires_hint": { "type": "boolean", "description": "Match only when the provider is named (option or text). For messages other products may also emit." },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "code": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "message": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Case-insensitive JavaScript regex sources" }
            }
          },
          "title": { "$ref": "#/$defs/i18n" },
          "cause": { "$ref": "#/$defs/i18n" },
          "retryable": { "type": "boolean" },
          "user_fix": { "$ref": "#/$defs/i18n" },
          "operator_fix": { "$ref": "#/$defs/i18n" },
          "docs": { "type": "string", "pattern": "^https://" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "verified": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["en", "id"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } }
    }
  }
}
